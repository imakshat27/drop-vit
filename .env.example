# Leave empty to use persistent local PostgreSQL at .data/drop
DATABASE_URL=
# Neon: use its pooled URL above; optional direct URL for schema migrations.
DATABASE_MIGRATION_URL=
APP_URL=http://localhost:3000
# Required to seed password-based demo accounts. Never use demo accounts in production.
SEED_DEMO_PASSWORD=
# SMTP enables verification emails. Without SMTP, signup remains available but unverified.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=<API key>.
# Verify drop.aksht.site in Resend before sending from the address below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Drop <hello@drop.aksht.site>
