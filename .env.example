# Leave empty to use persistent local PostgreSQL at .data/drop
DATABASE_URL=
# Neon: use its pooled URL above; optional direct URL for schema migrations.
DATABASE_MIGRATION_URL=
# Neon CLI writes this direct URL automatically; migrations use it when no override is set.
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
# Transactional submission, review and live emails. Google verifies sign-in emails.
# Brevo: SMTP_HOST=smtp-relay.brevo.com; copy SMTP_USER from its SMTP settings.
# SMTP_PASSWORD is a Brevo SMTP key. Verify droppp.tech before sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Drop <hello@droppp.tech>
# Google OAuth web client. Register APP_URL/auth/google/callback in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Google account email explicitly authorized to curate. Google verifies ownership before granting access.
# Comma-separated, explicitly authorized VIT curator addresses.
CURATOR_EMAIL=

# Neon private object storage (server-only; pull using neon env pull --service object-storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# First Monday launch, 00:00 IST. Leave as-is for production.
DROP_FIRST_RELEASE_AT=2026-10-25T18:30:00Z

# Server-only random secret authenticating background notification jobs.
NOTIFICATION_JOB_SECRET=
