{
  "name": "drop-vit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "build:cloudflare": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build && node scripts/cloudflare-runtime-env.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "services:check": "tsx --env-file-if-exists=.env.local scripts/check-services.ts",
    "test:e2e": "playwright test",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@neon/config": "^1.8.5",
    "@neon/env": "^1.5.2",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "nodemailer": "latest",
    "pg": "latest",
    "pg-cloudflare": "^1.4.1",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@opennextjs/cloudflare": "^1.20.9",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.9",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
