{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drop-vit",
  "workers_dev": true,
  "account_id": "ee86951ee9b792b8e8e816ef34b34591",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "droppp.tech", "custom_domain": true }],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "drop-vit" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a5f982b4f0184bb6a1dd5bdaaacc5f08" }],
  "vars": {
    "DROP_RUNTIME": "cloudflare",
    "APP_URL": "https://droppp.tech",
    "DROP_FIRST_RELEASE_AT": "2026-10-25T18:30:00Z",
    "SMTP_HOST": "smtp-relay.brevo.com",
    "SMTP_PORT": "587",
    "SMTP_FROM": "Drop <hello@droppp.tech>",
  },
  "observability": { "enabled": true },
}
